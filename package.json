{
  "name": "actual-untkn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend/UNTKN-Backend",
    "build": "npm run install:frontend && npm run build:frontend && rm -rf backend/UNTKN-Backend/dist && cp -a frontend/dist backend/UNTKN-Backend/dist",
    "build:frontend": "npm run build --prefix frontend",
    "start": "node server.js",
    "build:backend": "npm run build --prefix backend/UNTKN-Backend"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "razorpay": "^2.9.8"
  },
  "type": "module",
  "main": "server.js"
}
