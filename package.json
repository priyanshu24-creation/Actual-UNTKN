{
  "name": "actual-untkn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend/UNTKN-Backend",
    "build": "npm run install:frontend && npm run install:backend && npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --prefix frontend",
    "start": "node server.js",
    "build:backend": "npm run build --prefix backend/UNTKN-Backend"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "express": "^4.22.3"
  },
  "type": "module",
  "main": "server.js"
}
